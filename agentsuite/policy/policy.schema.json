{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsuite.dev/experimental/policy.schema.json",
  "title": "Experimental AgentSuite policy request (not an operator grant)",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "agent", "capabilities", "filesystem", "network", "invocations"],
  "properties": {
    "apiVersion": {"const": "agentsuite.dev/policy/v1alpha1"},
    "agent": {"$ref": "#/$defs/id"},
    "capabilities": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "version", "skills"],
      "properties": {
        "protocol": {"const": "a2a"},
        "version": {"const": "1.0.0"},
        "skills": {"type": "array", "items": {"$ref": "#/$defs/skill"}}
      }
    },
    "filesystem": {
      "type": "object", "additionalProperties": false, "required": ["write"],
      "properties": {"write": {"const": "deny"}}
    },
    "network": {
      "type": "object", "additionalProperties": false, "required": ["default", "allow"],
      "properties": {
        "default": {"const": "deny"},
        "allow": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/destination"}}
      }
    },
    "invocations": {
      "type": "object", "additionalProperties": false, "required": ["default", "allow"],
      "properties": {
        "default": {"const": "deny"},
        "allow": {
          "type": "array", "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["agent", "skills"],
            "properties": {
              "agent": {"$ref": "#/$defs/id"},
              "skills": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "skill": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "description", "tags"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "pattern": "\\S"},
        "description": {"type": "string", "pattern": "\\S"},
        "tags": {"type": "array", "items": {"type": "string"}}
      }
    },
    "destination": {
      "type": "object", "additionalProperties": false, "required": ["scheme", "host", "port"],
      "properties": {
        "scheme": {"enum": ["http", "https"]},
        "host": {"type": "string", "maxLength": 253, "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    }
  }
}
